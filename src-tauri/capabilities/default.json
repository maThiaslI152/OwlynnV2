{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-set-size",
    "shell:allow-open",
    "opener:default"
  ]
}
