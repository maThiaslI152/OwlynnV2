{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Owlynn",
  "version": "0.2.0",
  "identifier": "com.owlynn.app",
  "build": {
    "frontendDist": "../frontend-v2/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm --prefix frontend-v2 run dev",
    "beforeBuildCommand": "npm --prefix frontend-v2 run build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://127.0.0.1:8000 asset: https://asset.localhost; connect-src 'self' ws://127.0.0.1:8000 http://127.0.0.1:8000; font-src 'self';"
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "height": 720,
        "resizable": true,
        "title": "Owlynn",
        "width": 1100,
        "minWidth": 680,
        "minHeight": 480,
        "transparent": true,
        "decorations": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist"
    },
    "resources": {}
  }
}
