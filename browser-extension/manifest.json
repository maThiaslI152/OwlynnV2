{
  "manifest_version": 3,
  "name": "Owlynn Browser Bridge",
  "version": "1.1.0",
  "description": "Bridges Owlynn with your Brave browser: search, active tab context, and page sharing.",
  "permissions": ["tabs", "scripting", "contextMenus", "activeTab"],
  "host_permissions": [
    "<all_urls>",
    "*://www.google.com/*",
    "*://www.bing.com/*",
    "*://duckduckgo.com/*",
    "*://html.duckduckgo.com/*",
    "*://lite.duckduckgo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Owlynn Browser Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://www.google.com/*"],
      "js": ["content_google.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://www.bing.com/*"],
      "js": ["content_bing.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://duckduckgo.com/*",
        "*://html.duckduckgo.com/*",
        "*://lite.duckduckgo.com/*"
      ],
      "js": ["content_ddg.js"],
      "run_at": "document_end"
    }
  ]
}
